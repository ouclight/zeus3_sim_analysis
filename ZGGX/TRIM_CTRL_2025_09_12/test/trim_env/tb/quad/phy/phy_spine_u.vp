`timescale 1ns / 1ps 

module phy_spine_u ( D1_DUMP_READY_ASIC, D1_OSC_TM_RES_ASIC, D1_SPINE_RESET_N, D1_STOPWATCH_PERIOD, D1_STOPWATCH_RINGO_ASIC, D1_TM_REDUMP, D2_DUMP_READY_ASIC, D2_OSC_TM_RES_ASIC, D2_SPINE_RESET_N,
     D2_STOPWATCH_PERIOD, D2_STOPWATCH_RINGO_ASIC, D2_TM_REDUMP, D3_DUMP_READY_ASIC, D3_OSC_TM_RES_ASIC, D3_SPINE_RESET_N, D3_STOPWATCH_PERIOD, D3_STOPWATCH_RINGO_ASIC, D3_TM_REDUMP, DUMP_READY_ASIC,
     OSC_TM_RES_ASIC, SPINE_RESET_N, STOPWATCH_PERIOD, STOPWATCH_RINGO_ASIC, TM_REDUMP, TSV_TM_88_1, TSV_TM_332_205, VMON, vdd, vdd_array, vss, vss_array, D1_DUMP_READY, D1_OSC_TM_RES,
     D1_SPINE_RESET_N_ASIC, D1_STOPWATCH_PERIOD_ASIC, D1_STOPWATCH_RINGO, D1_TM_REDUMP_ASIC, D2_DUMP_READY, D2_OSC_TM_RES, D2_SPINE_RESET_N_ASIC, D2_STOPWATCH_PERIOD_ASIC, D2_STOPWATCH_RINGO,
     D2_TM_REDUMP_ASIC, D3_DUMP_READY, D3_OSC_TM_RES, D3_SPINE_RESET_N_ASIC, D3_STOPWATCH_PERIOD_ASIC, D3_STOPWATCH_RINGO, D3_TM_REDUMP_ASIC, DUMP_READY, OSC_TM_RES, SPINE_RESET_N_ASIC,
     STOPWATCH_PERIOD_ASIC, STOPWATCH_RINGO, TM_REDUMP_ASIC, TSV_TM_88_1_ASIC, TSV_TM_332_205_ASIC, ls_en_asic );


output  D1_DUMP_READY_ASIC, D1_SPINE_RESET_N, D1_STOPWATCH_PERIOD, D1_STOPWATCH_RINGO_ASIC, D1_TM_REDUMP, D2_DUMP_READY_ASIC, D2_SPINE_RESET_N, D2_STOPWATCH_PERIOD, D2_STOPWATCH_RINGO_ASIC,
     D2_TM_REDUMP, D3_DUMP_READY_ASIC, D3_SPINE_RESET_N, D3_STOPWATCH_PERIOD, D3_STOPWATCH_RINGO_ASIC, D3_TM_REDUMP, DUMP_READY_ASIC, SPINE_RESET_N, STOPWATCH_PERIOD, STOPWATCH_RINGO_ASIC, TM_REDUMP;

inout  VMON, vdd, vdd_array, vss, vss_array;

input  D1_DUMP_READY, D1_SPINE_RESET_N_ASIC, D1_STOPWATCH_PERIOD_ASIC, D1_STOPWATCH_RINGO, D1_TM_REDUMP_ASIC, D2_DUMP_READY, D2_SPINE_RESET_N_ASIC, D2_STOPWATCH_PERIOD_ASIC, D2_STOPWATCH_RINGO,
     D2_TM_REDUMP_ASIC, D3_DUMP_READY, D3_SPINE_RESET_N_ASIC, D3_STOPWATCH_PERIOD_ASIC, D3_STOPWATCH_RINGO, D3_TM_REDUMP_ASIC, DUMP_READY, SPINE_RESET_N_ASIC, STOPWATCH_PERIOD_ASIC, STOPWATCH_RINGO,
     TM_REDUMP_ASIC, ls_en_asic;

output [1:0]  OSC_TM_RES_ASIC;
output [1:0]  D3_OSC_TM_RES_ASIC;
output [1:0]  D1_OSC_TM_RES_ASIC;
output [1:0]  D2_OSC_TM_RES_ASIC;
output [87:0]  TSV_TM_88_1;
output [127:0]  TSV_TM_332_205;

input [1:0]  D3_OSC_TM_RES;
input [1:0]  D1_OSC_TM_RES;
input [1:0]  D2_OSC_TM_RES;
input [1:0]  OSC_TM_RES;
input [87:0]  TSV_TM_88_1_ASIC;
input [127:0]  TSV_TM_332_205_ASIC;

