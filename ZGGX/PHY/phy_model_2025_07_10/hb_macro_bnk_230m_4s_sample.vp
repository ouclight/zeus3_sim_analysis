`timescale 1ns / 1ps 

module hb_macro_bnk_230m_4s_sample ( bnksel_n_array_0, bnksel_n_array_1, gcadd_array, gcas_rd_array_0, gcas_rd_array_1, gcas_wr_array_0, gcas_wr_array_1, gradd_array, rdata_asic, rdrdy_n_asic,
     reset_n_array, rwdl_array, vdd, vdd_array, vss, bnksel_n_asic_0, bnksel_n_asic_1, cfg_dly_bnksel_n_0, cfg_dly_bnksel_n_1, cfg_dly_gcadd, cfg_dly_gcas_rd_0, cfg_dly_gcas_rd_1, cfg_dly_gcas_wr_0,
     cfg_dly_gcas_wr_1, clk_in_asic, gcadd_asic, gcas_rd_en_asic_0, gcas_rd_en_asic_1, gcas_wr_en_asic_0, gcas_wr_en_asic_1, gradd_asic, ls_en_asic, rdrdy_n_array_0, rdrdy_n_array_1, reset_n_asic,
     wdata_asic, wdata_oe_asic );


output  bnksel_n_array_0, bnksel_n_array_1, gcas_rd_array_0, gcas_rd_array_1, gcas_wr_array_0, gcas_wr_array_1, rdrdy_n_asic, reset_n_array;

inout  vdd, vdd_array, vss;

input  bnksel_n_asic_0, bnksel_n_asic_1, clk_in_asic, gcas_rd_en_asic_0, gcas_rd_en_asic_1, gcas_wr_en_asic_0, gcas_wr_en_asic_1, ls_en_asic, rdrdy_n_array_0, rdrdy_n_array_1, reset_n_asic,
     wdata_oe_asic;

output [271:0]  rdata_asic;
output [7:0]  gcadd_array;
output [12:0]  gradd_array;

inout [271:0]  rwdl_array;

input [1:0]  cfg_dly_gcas_rd_0;
input [1:0]  cfg_dly_gcas_wr_0;
input [1:0]  cfg_dly_bnksel_n_1;
input [12:0]  gradd_asic;
input [1:0]  cfg_dly_bnksel_n_0;
input [7:0]  gcadd_asic;
input [1:0]  cfg_dly_gcas_rd_1;
input [1:0]  cfg_dly_gcas_wr_1;
input [271:0]  wdata_asic;
input [1:0]  cfg_dly_gcadd;

