OD.DN.3
2 2 15 Aug 27 14:59:08 2025                    
OD.DN.3 { @ Minimum {{OD OR DOD} OR SR_DOD} local density [window 20 um x 20 um, stepping 10 um] >= 20% 
	EXC = NWDMY OR SEALRING_SIZE_1
  N = ALL_OD NOT EXC
  D = CHIP NOT EXC 
  EXC_M = COPY EXC
  A = CHIPx NOT EXC
  B1 = EXC_M NOT WITH EDGE (EXT [EXC_M] < OD_DN_3_E*2 SQUARE )
  B = CHIPx NOT (SIZE B1 BY OD_DN_3_E-0.001)
  ERR_WIN = DENSITY A B ALL_OD CHIP N D < OD_DN_3 WINDOW OD_DN_3_W STEP OD_DN_3_S BACKUP INSIDE OF LAYER CHIPx 
          [!AREA(B)+~(AREA(A)-OD_DN_3_E*OD_DN_3_E)*!!(AREA(A)-OD_DN_3_E*OD_DN_3_E)+AREA(N)/AREA(D)+!~(AREA(ALL_OD)/AREA(CHIP)-OD_DN_3)+!(AREA(ALL_OD)/AREA(CHIP)-OD_DN_3)]
  F = PUSH (WITH WIDTH (ERR_WIN NOT EXC_M) >= OD_DN_3_E)
  X = DENSITY A B F ALL_OD CHIP N D < OD_DN_3 WINDOW OD_DN_3_W STEP OD_DN_3_S BACKUP INSIDE OF LAYER CHIPx PRINT OD.DN.3.density RDB OD.DN.3.RDB.density
          [!AREA(F)+!AREA(B)+~(AREA(A)-OD_DN_3_E*OD_DN_3_E)*!!(AREA(A)-OD_DN_3_E*OD_DN_3_E)+AREA(N)/AREA(D)+!~(AREA(ALL_OD)/AREA(CHIP)-OD_DN_3)+!(AREA(ALL_OD)/AREA(CHIP)-OD_DN_3)]
  COPY X    
}
